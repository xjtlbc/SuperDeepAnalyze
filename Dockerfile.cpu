# ===== Stage 1: Build frontend =====
FROM node:22-slim AS frontend-builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /build
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
RUN pnpm run build

# ===== Stage 2: Install Python deps (throwaway builder) =====
FROM python:3.11-slim AS pip-builder

WORKDIR /install
COPY backend/requirements.txt .
# Install without docling/torch to keep image small (~1GB savings)
RUN grep -v -e '^#' -e '^docling' -e '^torch' requirements.txt | grep -v '^$' > /tmp/deps.txt && \
    pip install --timeout=300 --retries=5 -i https://mirrors.aliyun.com/pypi/simple/ --trusted-host mirrors.aliyun.com \
    --no-cache-dir --prefix=/install/deps -r /tmp/deps.txt && \
    echo "Deps installed without docling/torch"

# ===== Stage 3: Runtime (CPU-only, small) =====
FROM python:3.11-slim AS runtime

# Install nginx, supervisor, and libreoffice-writer for .doc support
RUN apt-get update && \
    apt-get install -y --no-install-recommends nginx supervisor libreoffice-writer antiword catdoc && \
    rm -rf /var/lib/apt/lists/*

# Copy stripped Python deps from builder
COPY --from=pip-builder /install/deps /usr/local

# Copy backend source
WORKDIR /app/backend
COPY backend/app/ ./app/
COPY backend/pyproject.toml .

# Copy built frontend
COPY --from=frontend-builder /build/dist/ /app/frontend/dist/

# Nginx config
COPY nginx.conf /etc/nginx/sites-available/superdeep
RUN ln -sf /etc/nginx/sites-available/superdeep /etc/nginx/sites-enabled/superdeep && \
    rm -f /etc/nginx/sites-enabled/default

# Supervisor config
COPY supervisord.conf /etc/supervisor/conf.d/superdeep.conf

# Entrypoint
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Create data directory skeleton
RUN mkdir -p /app/data/logs /app/data/faiss /app/data/knowledge_bases /app/data/tool_outputs

EXPOSE 80
VOLUME ["/app/data"]

ENV PYTHONUNBUFFERED=1
ENV TZ=Asia/Shanghai

WORKDIR /app
ENTRYPOINT ["/app/entrypoint.sh"]
